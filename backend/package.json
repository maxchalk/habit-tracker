{
  "name": "habit-tracker-backend",
  "version": "1.0.0",
  "description": "Backend API for Habit Tracker application",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "cross-env NODE_ENV=test jest --testEnvironment=node --forceExit --detectOpenHandles",
    "test:watch": "cross-env NODE_ENV=test jest --watch --testEnvironment=node",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage --testEnvironment=node --forceExit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "express-rate-limit": "^6.8.1",
    "helmet": "^7.0.0",
    "express-mongo-sanitize": "^2.2.0",
    "xss-clean": "^0.1.4",
    "express-validator": "^7.0.1",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "@types/jest": "^29.5.5",
    "cross-env": "^7.0.3"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": ["<rootDir>/tests/setup.js"],
    "testMatch": ["**/tests/**/*.test.js"],
    "moduleNameMapper": {
      "^winston$": "<rootDir>/tests/__mocks__/winston.js",
      "^fs$": "<rootDir>/tests/__mocks__/fs.js"
    },
    "collectCoverageFrom": [
      "**/*.js",
      "!**/node_modules/**",
      "!**/tests/**",
      "!**/logs/**"
    ]
  },
  "keywords": [
    "habit-tracker",
    "reminders",
    "api",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "Venkatesh Spandan",
  "license": "MIT"
}